/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_DESIGN MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "退出(&X)",                      ID_FILE_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "清除未使用的背景Tile",                ID_EDIT_CLEAR_UNUSE_BKG_TILE
        MENUITEM "清除未使用的精灵Tile",                ID_EDIT_CLEAR_UNUSE_SP_TILE
        MENUITEM "自动字符映射",                      ID_EDIT_AUTO_CHAR_MAPPING
        MENUITEM "自动映射全部字符",                    ID_EDIT_AUTO_FULL_CHAR_MAPPING
        MENUITEM "整理背景图案",                      ID_EDIT_BG_ORGANIZE
        MENUITEM "整理精灵图案",                      ID_EDIT_SP_ORGANIZE
        MENUITEM "背景字符映射",                      ID_EDIT_BG_CHAR_MAPPING
        MENUITEM "精灵字符映射",                      ID_EDIT_SP_CHAR_MAPPING
        MENUITEM "精灵大小 8*16 -> 8*8",            ID_EDIT_SP_8_16_TO_8_8
        MENUITEM "8*16精灵图形奇偶交换",                ID_EDIT_SP_ID_SWAP
        MENUITEM "8*8背景转精灵",                    ID_EDIT_BG_TILE_TO_SP_TILE
        MENUITEM "拷贝背景图案到精灵图案",                 ID_EDIT_BG_TO_SP
        MENUITEM "拷贝精灵图案到背景图案",                 ID_EDIT_SP_TO_BG
    END
    POPUP "图块工具"
    BEGIN
        MENUITEM "循环左移0123号颜色",                 ID_TILE_COLOR0123_MOVE_LEFT
        MENUITEM "循环右移0123号颜色",                 ID_TILE_COLOR0123_MOVE_RIGHT
        MENUITEM "循环左移123号颜色",                  ID_TILE_COLOR123_MOVE_LEFT
        MENUITEM "循环右移123号颜色",                  ID_TILE_COLOR123_MOVE_RIGHT
        MENUITEM "删除1号颜色",                      ID_TILE_DELETE_COLOR_1
        MENUITEM "删除2号颜色",                      ID_TILE_DELETE_COLOR_2
        MENUITEM "删除3号颜色",                      ID_TILE_DELETE_COLOR_3
        MENUITEM "像素上移",                        ID_TILE_MOVE_UP
        MENUITEM "像素下移",                        ID_TILE_MOVE_DOWN
        MENUITEM "像素左移",                        ID_TILE_MOVE_LEFT
        MENUITEM "像素右移",                        ID_TILE_MOVE_RIGHT
        MENUITEM "交换1号2号颜色",                    ID_TILE_SWAP_COLOR_1_2
        MENUITEM "交换1号3号颜色",                    ID_TILE_SWAP_COLOR_1_3
        MENUITEM "交换2号3号颜色",                    ID_TILE_SWAP_COLOR_2_3
    END
    POPUP "显示(&S)"
    BEGIN
        MENUITEM "显示背景图案",                      ID_SHOW_BG
        MENUITEM "显示精灵图案",                      ID_SHOW_SP
        MENUITEM "显示节目列表",                      ID_SHOW_LIST
        MENUITEM "显示文本组",                       ID_SHOW_CUSTOM_TEXT
        MENUITEM "显示标题",                        ID_SHOW_CAPTION
        MENUITEM "显示光标",                        ID_SHOW_CURSOR
    END
END


