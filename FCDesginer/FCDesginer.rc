            VALUE "FileDescription", "FCDesginer"
            VALUE "FileVersion", "1.0.1.53"
            VALUE "InternalName", "FCDesginer.exe"
            VALUE "LegalCopyright", "Copyright (C) 2023 FlameCyclone "
            VALUE "OriginalFilename", "FCDesginer.exe"
            VALUE "ProductName", "FCDesginer"
            VALUE "ProductVersion", "1.0.1.53"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END


